# Copy to a private .env file; keep it out of Git and protect access to the file.
QLMS_BACKUP_DATABASE_URL=postgresql://qlms_backup.PROJECT_REF:PRIVATE_PASSWORD@VERIFIED_SESSION_POOLER:5432/postgres?sslmode=require
QLMS_BACKUP_PROJECT_REF=PROJECT_REF
QLMS_DB_SCHEMA=qlms
QLMS_BACKUP_KEY_FILE=C:/PRIVATE_KEY_LOCATION/qlms-backup.key
QLMS_BACKUP_LOCAL_FOLDER=C:/PRIVATE_LOCAL_BACKUPS
QLMS_BACKUP_INDEPENDENT_FOLDER=C:/VERIFIED_PRIVATE_CLOUD_SYNC_FOLDER/QLMS
# The cloud folder must be private and its remote upload must be demonstrated.
# Do not put the encryption key in either backup folder. No deletion runs automatically.
