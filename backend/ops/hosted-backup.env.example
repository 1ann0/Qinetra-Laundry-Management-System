# Private cloud-runner configuration. Never commit filled values.
# This is separate from the already-connected interactive Drive plugin.
QLMS_BACKUP_PROVIDER=google_drive
QLMS_BACKUP_DATABASE_URL=postgresql://qlms_backup.PROJECT_REF:PRIVATE_PASSWORD@VERIFIED_SESSION_POOLER:5432/postgres?sslmode=require
QLMS_BACKUP_PROJECT_REF=PROJECT_REF
QLMS_DB_SCHEMA=qlms
QLMS_BACKUP_PG_CLIENT_IMAGE=postgres:17@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675
QLMS_BACKUP_KEY_FILE=C:/PRIVATE_KEY_LOCATION/qlms-backup.key
# Hosted environments may supply QLMS_BACKUP_KEY_BASE64 instead; never supply both.
QLMS_BACKUP_LOCAL_FOLDER=C:/PRIVATE_ENCRYPTED_WORK_FOLDER
QLMS_BACKUP_DRIVE_ACCOUNT=APPROVED_PRIVATE_ACCOUNT
QLMS_BACKUP_DRIVE_FOLDER_ID=VERIFIED_PRIVATE_FOLDER_ID
QLMS_DRIVE_CLIENT_ID=PRIVATE_AUTOMATION_CLIENT_ID
QLMS_DRIVE_CLIENT_SECRET=PRIVATE_AUTOMATION_CLIENT_SECRET
QLMS_DRIVE_REFRESH_TOKEN=PRIVATE_AUTOMATION_REFRESH_TOKEN
QLMS_BACKUP_RETENTION_DAYS=90
QLMS_BACKUP_STORAGE_BUDGET_BYTES=5000000000
# Keep 20% headroom; the runner checks real Drive free space before upload.
# Keep false until the isolated retention rehearsal passes.
QLMS_BACKUP_CLEANUP_ENABLED=false
# Status-only independent monitor. Keep its URL secret, never append logs.
QLMS_BACKUP_MONITOR_URL=https://hc-ping.com/PRIVATE_CHECK_UUID
