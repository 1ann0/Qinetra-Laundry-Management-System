# Development example. Never commit the actual .env or connection passwords.
DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:5432/LOCAL_DATABASE
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QLMS_DB_SCHEMA=public

# Pilot: use QLMS_ENV=production, QLMS_DB_SCHEMA=qlms and QLMS_DB_USER=qlms_runtime.
# DATABASE_URL must use the dedicated runtime login and sslmode=require (or stronger).
# ALLOWED_ORIGINS must list only the verified HTTPS frontend addresses.
# Admin/migration and read-only backup credentials stay separate from DATABASE_URL.
